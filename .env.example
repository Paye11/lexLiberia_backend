# Server
PORT=5000
NODE_ENV=development
MAX_FILE_SIZE=78643200

# Database
MONGODB_URI=mongodb://localhost:27017/lexliberia

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d

# Admin bootstrap (created on first startup if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Frontend URL for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000

# Google sign-in. Use the same OAuth client ID on Vercel as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# OpenAI — set the real key in Render, never in GitHub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Perplexity — Ask Me. Set the real key on Render, never in GitHub.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# Shown to subscribers so they can send Lonestar money themselves.
MANUAL_PAY_NAME=Bill P. Alex
MANUAL_PAY_PHONE=0888907840

# Phone alerts for the admin app. Generate once and keep the private key on Render only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:billadmin@lexliberia.com

# Email (optional — messages/notices still saved if SMTP is not set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="LexLiberia <noreply@example.com>"
